{
  "name": "deno-simple",
  "version": "0.1.0",
  "exports": "./server.ts",
  "desktop": {
    "app": {
      "name": "Writasuarus",
      "identifier": "io.github.8bitreed.dino-writer"
    },
    "output": {
      "linux": "./desktop/DenoSimple.AppImage",
      "windows": "./desktop/DenoSimple.msi",
      "macos": "./desktop/DenoSimple.app"
    }
  },
  "compilerOptions": {
    "checkJs": true,
    "strict": true,
    "lib": [
      "deno.window",
      "deno.unstable",
      "deno.desktop",
      "dom",
      "dom.iterable"
    ]
  },
  "fmt": {
    "lineWidth": 100,
    "semiColons": true,
    "singleQuote": false
  },
  "lint": {
    "rules": {
      "tags": ["recommended"]
    }
  },
  "tasks": {
    "build": "deno run -A build.ts",
    "check": "deno fmt --check && deno lint && deno check src/main.ts server.ts build.ts src/assets/pages/editor.ts && deno test --allow-read=dist,tests",
    "desktop": "deno desktop --allow-env=HOME,XDG_DATA_HOME,LOCALAPPDATA,APPDATA,DENO_SERVE_ADDRESS --allow-net --allow-read --allow-write --allow-run=zenity,osascript,powershell .",
    "desktop:dev": "deno task build && deno desktop --hmr --allow-env=HOME,XDG_DATA_HOME,LOCALAPPDATA,APPDATA,PORT,DENO_SERVE_ADDRESS --allow-net --allow-read --allow-write --allow-run=zenity,osascript,powershell server.ts",
    "dev": "deno task build && deno run --allow-env=PORT --allow-net --allow-read=dist --watch=src/,dist/ src/main.ts",
    "dev:assets": "deno run -A build.ts --watch",
    "start": "deno run --allow-env=PORT --allow-net --allow-read=dist src/main.ts"
  },
  "imports": {
    "@std/http": "jsr:@std/http@^1.1.3",
    "@std/path": "jsr:@std/path@^1.1.4"
  }
}
